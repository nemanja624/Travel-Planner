<?xml version="1.0" encoding="utf-8"?>
<ApplicationManifest xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" ApplicationTypeName="TravelPlannerType" ApplicationTypeVersion="1.0.0" xmlns="http://schemas.microsoft.com/2011/01/fabric">
  <Parameters>
    <Parameter Name="Gateway_ASPNETCORE_ENVIRONMENT" DefaultValue="" />
    <Parameter Name="Gateway_InstanceCount" DefaultValue="-1" />
    <Parameter Name="AuthService_MinReplicaSetSize" DefaultValue="1" />
    <Parameter Name="AuthService_TargetReplicaSetSize" DefaultValue="1" />
    <Parameter Name="AuthService_PartitionCount" DefaultValue="1" />
    <Parameter Name="TripService_MinReplicaSetSize" DefaultValue="1" />
    <Parameter Name="TripService_TargetReplicaSetSize" DefaultValue="1" />
    <Parameter Name="TripService_PartitionCount" DefaultValue="1" />
  </Parameters>
  <!-- Import the ServiceManifest from the ServicePackage. The ServiceManifestName and ServiceManifestVersion 
       should match the Name and Version attributes of the ServiceManifest element defined in the 
       ServiceManifest.xml file. -->
  <ServiceManifestImport>
    <ServiceManifestRef ServiceManifestName="GatewayPkg" ServiceManifestVersion="1.0.0" />
    <ConfigOverrides />
    <EnvironmentOverrides CodePackageRef="code">
      <EnvironmentVariable Name="ASPNETCORE_ENVIRONMENT" Value="[Gateway_ASPNETCORE_ENVIRONMENT]" />
    </EnvironmentOverrides>
  </ServiceManifestImport>
  <DefaultServices>
    <Service Name="Gateway" ServicePackageActivationMode="ExclusiveProcess">
      <StatelessService ServiceTypeName="GatewayType" InstanceCount="[Gateway_InstanceCount]">
        <SingletonPartition />
      </StatelessService>
    </Service>
    <Service Name="AuthService" ServicePackageActivationMode="ExclusiveProcess">
      <StatefulService ServiceTypeName="AuthStatefulServiceType" TargetReplicaSetSize="[AuthService_TargetReplicaSetSize]" MinReplicaSetSize="[AuthService_MinReplicaSetSize]">
        <UniformInt64Partition PartitionCount="[AuthService_PartitionCount]" LowKey="0" HighKey="0" />
      </StatefulService>
    </Service>
    <Service Name="TripService" ServicePackageActivationMode="ExclusiveProcess">
      <StatefulService ServiceTypeName="TripStatefulServiceType" TargetReplicaSetSize="[TripService_TargetReplicaSetSize]" MinReplicaSetSize="[TripService_MinReplicaSetSize]">
        <UniformInt64Partition PartitionCount="[TripService_PartitionCount]" LowKey="0" HighKey="0" />
      </StatefulService>
    </Service>
  </DefaultServices>
</ApplicationManifest>
